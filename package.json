{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --turbopack -p 9002\" \"npm run sanity:dev\" \"npm run genkit:dev\"",
    "dev:app": "concurrently \"next dev --turbopack -p 9002\" \"npm run sanity:dev\" \"npm run genkit:dev\"",
    "dev:full": "concurrently \"next dev --turbopack -p 9002\" \"npm run sanity:dev\" \"npm run genkit:dev\"",
    "dev:simple": "concurrently \"next dev --turbopack -p 9002\" \"npm run sanity:dev\"",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "build:cloudflare": "npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sanity:dev": "cd studio && sanity dev",
    "seed:kip-kuliah": "npx tsx scripts/seed-kip-kuliah-page.ts",
    "pages:build": "npm run build",
    "pages:dev": "npx wrangler pages dev .next --compatibility-date=2024-01-01",
    "analyze": "ANALYZE=true npm run build"
  },
